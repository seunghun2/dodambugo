{
    "framework": "nextjs",
    "ignoreCommand": "git log -1 --pretty=%B | grep -qi '\\[skip ci\\]' && exit 0 || exit 1",
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "crons": [
        {
            "path": "/api/cron/reminders",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron/deposit-alert",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron/thanks-notify",
            "schedule": "0 1 * * *"
        },
        {
            "path": "/api/cron/burial-review-notify",
            "schedule": "0 8 * * *"
        },
        {
            "path": "/api/cron/funeral-reminder",
            "schedule": "0 * * * *"
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "dodambugo.com"
                }
            ],
            "destination": "https://maeumbugo.co.kr/:path*",
            "permanent": true
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "www.dodambugo.com"
                }
            ],
            "destination": "https://maeumbugo.co.kr/:path*",
            "permanent": true
        }
    ]
}