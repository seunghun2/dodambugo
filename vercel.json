{
    "framework": "nextjs",
    "ignoreCommand": "git log -1 --pretty=%B | grep -qi '\\[skip ci\\]' && exit 0; git diff --name-only HEAD~1 HEAD | grep -qE '\\.(tsx?|jsx?|css|json|mjs)$' && exit 1 || exit 0",
    "buildCommand": "npm run build",
    "outputDirectory": ".next",
    "installCommand": "npm install",
    "crons": [
        {
            "path": "/api/cron/reminders",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/cron/deposit-alert",
            "schedule": "0 * * * *"
        }
    ],
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "dodambugo.com"
                }
            ],
            "destination": "https://maeumbugo.co.kr/:path*",
            "permanent": true
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "www.dodambugo.com"
                }
            ],
            "destination": "https://maeumbugo.co.kr/:path*",
            "permanent": true
        }
    ]
}